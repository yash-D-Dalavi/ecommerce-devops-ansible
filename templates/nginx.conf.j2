# {{ ansible_managed }}
upstream user_service  { server 127.0.0.1:{{ user_service_port }}; }
upstream order_service { server 127.0.0.1:{{ order_service_port }}; }

server {
    listen {{ nginx_http_port }};
    server_name {{ server_name }};
    root  {{ web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/users/ {
        proxy_pass http://user_service/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/orders/ {
        proxy_pass http://order_service/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /health {
        default_type text/plain;
        return 200 "OK\n";
    }
}
